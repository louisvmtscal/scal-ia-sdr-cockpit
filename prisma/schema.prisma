// Schéma Prisma — Scal-IA, assistant personnel SDR
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js -----------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  SDR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(SDR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  rendezVous RendezVous[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Domaine : cockpit SDR -----------------------------------------------

enum Origine {
  INBOUND
  OUTBOUND
}

enum HonoreStatus {
  EN_ATTENTE
  OUI
  NON
  A_REPLACER
}

/** Ancien canal SMS (Brevo) — conservé (non détruit) le temps de valider WhatsApp/Lemlist. */
enum SmsStatus {
  PENDING
  SENT
  FAILED
}

/** Canal WhatsApp (Lemlist). QUEUED = lead inscrit dans Lemlist, message pas encore confirmé envoyé. */
enum WhatsappStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

model RendezVous {
  id String @id @default(cuid())

  // Commercial en charge du RDV — lien vers un vrai compte utilisateur
  // (remplace l'ancien enum Commercial figé à Louis/Chloé, pour pouvoir
  // accueillir n'importe quel nouveau SDR sans modification de schéma).
  commercialId String
  commercial   User   @relation(fields: [commercialId], references: [id])

  origine Origine

  nom       String
  prenom    String
  societe   String
  poste     String?
  email     String?
  telephone String?
  linkedin  String?

  dateRDV DateTime

  honore   HonoreStatus @default(EN_ATTENTE)
  qualifie Boolean      @default(false)

  notes       String?
  compteRendu Json?
  preparation Json?
  emailJ25    Json?

  // --- Ancien canal SMS J-1/H-2 (Brevo) — conservé, plus utilisé par le cron actif (voir services/whatsapp-rappels.ts) ---
  smsJ1Status    SmsStatus @default(PENDING)
  smsJ1SentAt    DateTime?
  smsJ1MessageId String?

  smsH2Status    SmsStatus @default(PENDING)
  smsH2SentAt    DateTime?
  smsH2MessageId String?

  smsLastError String?

  // --- Rappel SMS jour J, 9h10 Europe/Paris (Brevo) — canal actif (voir services/rappel-jour-j.ts) ---
  smsJourJStatus    SmsStatus @default(PENDING)
  smsJourJSentAt    DateTime?
  smsJourJMessageId String?

  // --- Canal WhatsApp (Lemlist) — canal actif pour les rappels J-1 / H-2 ---
  whatsappJ1Status     WhatsappStatus @default(PENDING)
  whatsappJ1SentAt     DateTime?
  whatsappJ1ExternalId String?
  whatsappJ1CampaignId String?

  whatsappH2Status     WhatsappStatus @default(PENDING)
  whatsappH2SentAt     DateTime?
  whatsappH2ExternalId String?
  whatsappH2CampaignId String?

  whatsappLastError String?

  firefliesMeetingId    String?   @unique
  firefliesMeetingTitle String?
  firefliesMeetingDate  DateTime?
  firefliesMeetingUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateRDV])
  @@index([commercialId])
  @@map("rendez_vous")
}

// Contenus éditables sans toucher au code : messages d'automatisation et
// prompts IA (compte rendu, préparation de rendez-vous).
model Template {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  category String

  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("templates")
}
