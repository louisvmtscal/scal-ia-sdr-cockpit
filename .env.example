# --- Base de données -------------------------------------------------------
# Développement local : lance `pnpm exec prisma dev` puis colle l'URL TCP
# affichée (postgres://postgres:postgres@localhost:PORT/template1?sslmode=disable).
# Production (Supabase) : Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Auth.js ----------------------------------------------------------------
# Génère une valeur avec: openssl rand -base64 32
AUTH_SECRET="[GENERATED_SECRET]"
AUTH_URL="http://localhost:3000"

# --- IA (compte rendu automatique) ------------------------------------------
# Clé API Anthropic (https://console.anthropic.com/) — requise pour générer
# automatiquement la synthèse structurée d'un rendez-vous.
ANTHROPIC_API_KEY="[ANTHROPIC_API_KEY]"

# --- Email (compte rendu + préparation, via Resend) --------------------------
# https://resend.com — le domaine d'envoi doit être vérifié (DNS).
RESEND_API_KEY="[RESEND_API_KEY]"
MAIL_FROM="[MAIL_FROM]"

# --- Fireflies.ai (recherche, transcription, webhook) ------------------------
# Clé personnelle : app.fireflies.ai > Settings > Developer settings > Personal
FIREFLIES_API_KEY="[FIREFLIES_API_KEY]"
FIREFLIES_API_URL="https://api.fireflies.ai/graphql"
# Secret partagé avec le webhook configuré sur app.fireflies.ai
FIREFLIES_WEBHOOK_SECRET="[FIREFLIES_WEBHOOK_SECRET]"

# --- Cron (fiche de préparation quotidienne, Vercel Cron) --------------------
CRON_SECRET="[CRON_SECRET]"

# --- Ancien canal SMS (Brevo) — conservé, plus utilisé par le cron actif ----
# Clé API REST (préfixe "xkeysib-", PAS la clé SMTP "xsmtpsib-") :
# Brevo > Settings > SMTP & API > onglet "API Keys".
BREVO_API_KEY="[BREVO_API_KEY]"
# Nom d'expéditeur SMS validé dans Brevo (Senders > SMS), 11 caractères max.
BREVO_SMS_SENDER="[BREVO_SMS_SENDER]"

# --- Rappels WhatsApp J-1 / H-2 (Lemlist) — canal actif ----------------------
LEMLIST_API_KEY="[LEMLIST_API_KEY]"
LEMLIST_API_URL="https://api.lemlist.com/api"
LEMLIST_WHATSAPP_J1_CAMPAIGN_ID="[LEMLIST_WHATSAPP_J1_CAMPAIGN_ID]"
LEMLIST_WHATSAPP_H2_CAMPAIGN_ID="[LEMLIST_WHATSAPP_H2_CAMPAIGN_ID]"
LEMLIST_WHATSAPP_SEND_USER_ID="[LEMLIST_WHATSAPP_SEND_USER_ID]"
LEMLIST_WHATSAPP_SEND_USER_ACCOUNT_ID="[LEMLIST_WHATSAPP_SEND_USER_ACCOUNT_ID]"
LEMLIST_WEBHOOK_SECRET="[LEMLIST_WEBHOOK_SECRET]"
